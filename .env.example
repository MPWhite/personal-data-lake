# ── Strava ────────────────────────────────────────────────
# Create an API app at https://www.strava.com/settings/api
# Then run: npm run auth:strava   (fills in the refresh token)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# ── Garmin ────────────────────────────────────────────────
# Your normal Garmin Connect login (unofficial API)
GARMIN_USERNAME=
GARMIN_PASSWORD=
# How many days of daily wellness (steps/sleep/HR) to backfill on first sync
GARMIN_BACKFILL_DAYS=30

# ── Linq (outbound texting: iMessage / RCS / SMS) ─────────
# One-time setup: npx @linqapp/cli signup   (then `linq whoami` shows key + number)
LINQ_API_KEY=
# The Linq Number messages are sent from (E.164, e.g. +12055551234)
LINQ_NUMBER=
# Default recipient — your own phone (E.164). On the free tier this number
# must be added as a contact and text the Linq Number once before it can
# receive messages.
LINQ_DEFAULT_TO=

# ── Gmail ─────────────────────────────────────────────────
# Create OAuth credentials (Desktop app) at https://console.cloud.google.com/apis/credentials
# Enable the Gmail API, then run: npm run auth:gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# How many days of email to backfill on first sync
GMAIL_BACKFILL_DAYS=30
# Optional extra Gmail search filter applied to every sync, e.g. "-category:promotions"
GMAIL_QUERY=
